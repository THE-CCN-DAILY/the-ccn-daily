{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dev Server (Express + Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Vite Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 4173
    },
    {
      "name": "Cloudflare Pages Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "cf:dev"],
      "port": 8788
    },
    {
      "name": "Remotion Studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "remotion:studio", "--", "--port", "3001"],
      "port": 3001
    }
  ]
}
