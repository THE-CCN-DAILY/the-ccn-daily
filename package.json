{
  "name": "the-ccn-daily-project-phoenix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev dist --compatibility-flag nodejs_compat --port 8788",
    "cf:deploy": "npm run build && wrangler pages deploy dist",
    "cf:typecheck": "tsc -p tsconfig.cloudflare.json --noEmit",
    "db:apply:local": "wrangler d1 execute project_phoenix_ccn_daily --local --file=schema/d1-schema.sql",
    "db:apply": "wrangler d1 execute project_phoenix_ccn_daily --remote --file=schema/d1-schema.sql",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts VerseCard out/verse-card.mp4"
  },
  "dependencies": {
    "@remotion/player": "^4.0.464",
    "@tailwindcss/vite": "^4.2.2",
    "dompurify": "^3.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "flutterwave-react-v3": "^1.3.3",
    "hono": "^4.12.18",
    "jose": "^5.10.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "remotion": "^4.0.464",
    "resend": "^6.9.4",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.92.0"
  }
}
