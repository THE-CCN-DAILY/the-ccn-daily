# Firebase Configuration
# These are automatically provided by the platform in firebase-applet-config.json
# but documented here for completeness.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Look for "firestoreDatabaseId" in your firebase-applet-config.json file.
# It usually starts with "ai-studio-..."
FIREBASE_FIRESTORE_DATABASE_ID=

# AI Configuration
# The Gemini API Key for direct client-side access (Firebase AI Logic)
API_KEY=

# Google Cloud / Vertex AI Configuration (For Genkit Orchestrator)
# These are typically needed when running in a production Google Cloud environment.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
