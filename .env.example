# ─────────────────────────────────────────────────────────────────────────────
# THE CCN DAILY — Environment Variables
# Copy this file to .env.local and fill in real values before deploying.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (client-side — safe to expose) ──────────────────────────────────
# Firebase config — set these in Cloudflare Pages env vars and GitHub Secrets.
# Re-document here so new contributors know what they're looking at.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=   # usually starts with "ai-studio-..."

# ── Firebase Cloud Messaging (FCM) — Push Notifications ──────────────────────
# Get your VAPID key from Firebase Console → Project Settings → Cloud Messaging
# → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# ── Payment (Flutterwave) ────────────────────────────────────────────────────
# Get your public key from https://dashboard.flutterwave.com
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...

# ── Bible API (API.Bible) ────────────────────────────────────────────────────
# Register at https://scripture.api.bible/ — free tier available
VITE_API_BIBLE_KEY=
VITE_API_BIBLE_ID_WEB=   # World English Bible
VITE_API_BIBLE_ID_KJV=   # King James Version
VITE_API_BIBLE_ID_ASV=   # American Standard Version

# ── Email — server-side only (Cloudflare Worker) ────────────────────────────
# Set via wrangler, never in .env files — the Worker calls Resend directly.
# wrangler secret put RESEND_API_KEY
# Sender domain (configure in Resend dashboard): gifts@theccndaily.com

# ── Video (Cloudflare Stream) ────────────────────────────────────────────────
# Server-side secrets — set via wrangler, NOT here. See bottom of this file.
#   CF_ACCOUNT_ID    — your Cloudflare account id
#   CF_STREAM_TOKEN  — API token scoped to Stream:Edit (https://dash.cloudflare.com → My Profile → API Tokens)
#
# Client-side (safe to expose — appears in every public playback URL):
# Found in the Cloudflare Stream dashboard (format: customer-<code>).
VITE_CF_STREAM_CUSTOMER_SUBDOMAIN=   # e.g. customer-xxxxxxxx

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Pages / Worker secrets — set via wrangler, NOT in .env files
# ─────────────────────────────────────────────────────────────────────────────
#
# wrangler secret put ADMIN_API_TOKEN
# wrangler secret put CF_ACCOUNT_ID
# wrangler secret put CF_STREAM_TOKEN          # API token scoped to Stream:Edit
# wrangler secret put RESEND_API_KEY
# wrangler secret put MEDIA_PUBLIC_BASE_URL
# wrangler secret put WORKERS_AI_TEXT_MODEL
#
# D1 database — run once, then paste returned ID into wrangler.toml:
# wrangler d1 create project_phoenix_ccn_daily
#
# Apply schema to remote D1:
# npm run db:apply
